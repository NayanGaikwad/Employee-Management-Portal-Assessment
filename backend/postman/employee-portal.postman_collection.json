{
  "info": {
    "_postman_id": "employee-portal-collection",
    "name": "Employee Portal API",
    "description": "API test suite for the Employee Management Portal backend. Run with Newman or Postman Collection Runner: newman run collection.json -e environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200 and a token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.environment.set('adminToken', body.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register (Viewer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registers a new user', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.user.roleName).to.eql('EMPLOYEE_VIEWER');",
                  "  pm.environment.set('viewerToken', body.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List employees (pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns paginated list with metadata', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('items');",
                  "  pm.expect(body).to.have.property('page');",
                  "  pm.expect(body).to.have.property('pageSize');",
                  "  pm.expect(body).to.have.property('totalItems');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "  pm.expect(body.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Search and filter employees",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('search/filter returns employees', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees?search=@company.com&status=ACTIVE&sort=joiningDate&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "search", "value": "@company.com" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "sort", "value": "joiningDate" },
                { "key": "direction", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Create employee (valid)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('uniqueEmail', 'pm_' + Date.now() + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('creates an employee', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.email).to.eql(pm.environment.get('uniqueEmail'));",
                  "  pm.environment.set('createdEmployeeId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Employee\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"departmentId\": {{activeDepartmentId}},\n  \"jobTitle\": \"Engineer\",\n  \"joiningDate\": \"2023-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Reject missing/invalid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rejects invalid data with 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"departmentId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Reject duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rejects duplicate email with 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"departmentId\": {{activeDepartmentId}},\n  \"jobTitle\": \"Engineer\",\n  \"joiningDate\": \"2023-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Update employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('updates an employee', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.jobTitle).to.eql('Senior Engineer');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobTitle\": \"Senior Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{createdEmployeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{createdEmployeeId}}"]
            }
          }
        },
        {
          "name": "Delete (soft-deactivate) employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('soft-deletes an employee', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.deletedAt).to.not.eql(null);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees/{{createdEmployeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{createdEmployeeId}}"]
            }
          }
        },
        {
          "name": "Invalid employee id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 404 for unknown employee', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees/999999999",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "999999999"]
            }
          }
        },
        {
          "name": "Unauthorized (no token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 401 without a token', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        },
        {
          "name": "Viewer forbidden from creating (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 403 for viewer', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{viewerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Forbidden\",\n  \"email\": \"forbidden@example.com\",\n  \"departmentId\": {{activeDepartmentId}},\n  \"jobTitle\": \"Engineer\",\n  \"joiningDate\": \"2023-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('lists departments', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  if (body.length > 0) {",
                  "    pm.environment.set('activeDepartmentId', body[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": ["{{baseUrl}}"],
              "path": ["departments"]
            }
          }
        },
        {
          "name": "Invalid department id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 404 for unknown department', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/departments/999999999",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "999999999"]
            }
          }
        }
      ]
    }
  ]
}
