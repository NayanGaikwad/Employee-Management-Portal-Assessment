# Base URL for the backend API, including the /api prefix.
#
# Development: optional. When unset, the app calls the same-origin path `/api`,
# which the Vite dev server proxies to http://localhost:3000 (see vite.config.ts).
#
# Production (e.g. Vercel with a separately-deployed backend): REQUIRED.
# Point this at the deployed backend so the browser talks to it directly:
#
# VITE_API_BASE_URL=https://your-backend-host/api
#
VITE_API_BASE_URL=http://localhost:3000/api