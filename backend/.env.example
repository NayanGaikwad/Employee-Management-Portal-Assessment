# Environment configuration example.
# Copy to .env and fill in real values. NEVER commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/employee_portal?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1h"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"
# Used by the `seed:admin` script to provision an administrator role/user.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
